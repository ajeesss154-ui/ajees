# Local PC setup works without a database server. Never commit .env.local.
# Set a standard PostgreSQL connection string for a deployed multi-user service.
DATABASE_URL=
AURA_DATA_DIR=.data/aura-db

# Gemini preserves the existing project's provider choice. Keys stay server-side.
# Provider availability, free tier eligibility and quotas depend on your account.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# To switch: AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional Google connectors. Configure the exact callback in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/api/oauth/google/callback
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTEGRATION_ENCRYPTION_KEY=
# Optional for reverse-proxied deployments; exact scheme/hostname/port.
AURA_APP_ORIGIN=
# Set true for database providers requiring verified TLS.
DATABASE_SSL=false
