# Generate your own strong token: python -c "import secrets; print(secrets.token_urlsafe(32))"
AURA_ACCESS_TOKEN=
AURA_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_LIVE_MODEL=gemini-3.8-live
# Optional provider switch:
# AURA_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# For a hosted web UI, add its exact HTTPS origin; never put provider keys in it.
AURA_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8787,http://127.0.0.1:8787,https://appassets.androidplatform.net
AURA_REQUESTS_PER_MINUTE=30
